pipeline {
    agent any

    environment {
        DOCKER_HUB = "muraddevops/simple-webapp"
        KUBECONFIG = "/var/lib/jenkins/.kube/config" // Update to your kubeconfig path
    }

    stages {
        stage('Clone Repo') {
            steps {
                git branch: 'main', url: 'https://github.com/cmurad0215/simple_python_flask_k8s.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    docker.build("${DOCKER_HUB}:latest")
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'b64377b3-be03-4ca9-a567-b1f945ded8d6') {
                        docker.image("${DOCKER_HUB}:latest").push()
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh """
                kubectl apply -f k8s-deployment.yaml
                kubectl rollout status deployment/simple-webapp
                """
            }
        }
    }

    post {
        success {
            echo "Deployment successful!"
        }
        failure {
            echo "Deployment failed!"
        }
    }
}
